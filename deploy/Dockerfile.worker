FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/home/appuser/.local/bin:$PATH"

RUN groupadd --system appgroup \
    && useradd --system --gid appgroup --create-home appuser

COPY --chown=appuser:appgroup pyproject.toml uv.lock README.md alembic.ini ./
COPY --chown=appuser:appgroup src ./src
COPY --chown=appuser:appgroup alembic ./alembic

RUN pip install --no-cache-dir uv \
    && uv sync --frozen --no-dev \
    && chown -R appuser:appgroup /app

USER appuser

# No host ports; SIGTERM handling lives in ingestion/processing consumers.
# Compose overrides module: ingestion_main vs processing_main.
CMD [".venv/bin/python", "-m", "doc_pipeline.worker.ingestion_main"]
