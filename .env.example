# Copy to repo-root .env (gitignored). Local / LocalStack demo values only — not production.

# Postgres (Compose service `postgres`; host port 5432)
POSTGRES_USER=doc_pipeline
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=doc_pipeline
DATABASE_URL=postgresql+asyncpg://doc_pipeline:change-me-local@localhost:5432/doc_pipeline
# In-network (api/worker on doc-pipeline network):
# DATABASE_URL=postgresql+asyncpg://doc_pipeline:change-me-local@postgres:5432/doc_pipeline
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0
# In-network: redis://redis:6379/0

# LocalStack (host port 4566; Compose sets SQS_ENDPOINT_STRATEGY=off and LOCALSTACK_HOST=localstack:4566 for path-style / in-network queue URLs)
APP_ENV=dev
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=dev-doc-pipeline
SQS_QUEUE_URL=http://localhost:4566/000000000000/dev-document-ingestion
SQS_DLQ_URL=http://localhost:4566/000000000000/dev-document-ingestion-dlq
SQS_PROCESSING_QUEUE_URL=http://localhost:4566/000000000000/dev-document-processing
SQS_PROCESSING_DLQ_URL=http://localhost:4566/000000000000/dev-document-processing-dlq
# ReceiveMessage override; must match queue VisibilityTimeout (default 300, not 60)
# SQS_VISIBILITY_TIMEOUT_SECONDS=300
# In-network endpoint: http://localstack:4566

# JWT auth — stub default (ADR-013); Cognito swap when AWS available
AUTH_BACKEND=stub
JWT_ISSUER=http://localhost:8000/dev-issuer
JWT_AUDIENCE=doc-pipeline
JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAstub\n-----END PUBLIC KEY-----
# Dev minting only — generate matching pair via `make gen-dev-jwt`; never commit a real private key
JWT_PRIVATE_KEY_PEM=
# Optional host-side path overrides for minting tools (API uses JWT_PUBLIC_KEY_PEM via Compose)
JWT_PUBLIC_KEY_PATH=
JWT_PRIVATE_KEY_PATH=
# Host minting only (make gen-dev-jwt) — not mounted into containers
JWT_PUBLIC_KEY_FILE=./.local/jwt/public.pem
# Unused when AUTH_BACKEND=stub; set when Cognito User Pool exists
COGNITO_JWKS_URL=

STUB_VIRUS_CLEAN=true
# Hook backends: stub (default) or http (requires URL below)
VIRUS_HOOK_BACKEND=stub
OCR_HOOK_BACKEND=stub
# Optional HTTP sidecars when backend=http (no real vendor secrets)
VIRUS_SCAN_URL=
OCR_URL=

LOG_LEVEL=INFO

# Stuck-job scanner (asyncio sidecar — `python -m doc_pipeline.worker.stuck_main`)
STUCK_JOB_OLDER_THAN_SECONDS=1800
STUCK_SCAN_INTERVAL_SECONDS=60

# Outbound webhooks (HMAC). Prefer tenants.config_json webhook_url / webhook_secret;
# these defaults are local-demo fallbacks only — never commit real secrets.
WEBHOOK_TIMEOUT_SECONDS=5.0
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_DEFAULT_URL=
WEBHOOK_DEFAULT_SECRET=change-me-local-webhook

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=doc-pipeline-api
# Empty value is treated as false (SDK enabled). Set true to disable locally.
OTEL_SDK_DISABLED=

# 0 = unlimited (local ceiling overlay). Default 120.
# RATE_LIMIT_PER_MINUTE=120

# Grafana (Compose service `grafana`; host port 3000)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
