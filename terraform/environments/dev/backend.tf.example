terraform {
  backend "s3" {
    bucket         = "REPLACE_ACCOUNT_ID-doc-pipeline-tfstate-dev"
    key            = "doc-pipeline/dev/terraform.tfstate"
    region         = "eu-central-1"
    dynamodb_table = "REPLACE_ACCOUNT_ID-doc-pipeline-tflock-dev"
    encrypt        = true
  }
}
