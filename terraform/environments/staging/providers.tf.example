# Copy to providers.tf when wiring an environment root.
# FinOps default_tags (spec §5.5 / Appendix C).

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = "doc-pipeline"
      Environment = var.environment
      CostCenter  = var.cost_center
      Owner       = var.owner
    }
  }
}

variable "aws_region" {
  type    = string
  default = "eu-central-1"
}

variable "environment" {
  type = string
}

variable "cost_center" {
  type = string
}

variable "owner" {
  type = string
}
